<Window x:Class="MemoryAnalyzer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:MemoryAnalyzer.App.Converters"
        Title="Memory Analyzer" Width="1220" Height="820" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#E9EEF0"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#172126" />
        <SolidColorBrush x:Key="Muted" Color="#63737B" />
        <SolidColorBrush x:Key="Panel" Color="#F8FAF9" />
        <SolidColorBrush x:Key="Line" Color="#D6DEE1" />
        <SolidColorBrush x:Key="Blue" Color="#285D73" />
        <SolidColorBrush x:Key="Sage" Color="#3D7868" />
        <SolidColorBrush x:Key="Copper" Color="#B85F35" />
        <SolidColorBrush x:Key="Amber" Color="#A47727" />
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}" /></Style>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="TrackStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="5" />
            <Setter Property="Background" Value="#DFE5E6" />
            <Setter Property="Foreground" Value="{StaticResource Blue}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="86" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#285D73" Padding="18,9"
                Visibility="{Binding Update.HasUpdate, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Update.Message}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Update.ProgressText}" Foreground="#C9DFE7" Margin="12,0,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="更新する" Click="UpdateButton_Click" Padding="16,7" Background="White" Foreground="#285D73"
                            BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"
                            IsEnabled="{Binding Update.IsBusy, Converter={StaticResource InverseBool}}" />
                    <Button Content="あとで" Click="DismissUpdateButton_Click" Padding="11,7" Background="Transparent" Foreground="White"
                            BorderThickness="1" BorderBrush="#7FA7B5" Cursor="Hand" Margin="10,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="#F8FAF9" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="30,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="MEMORY ANALYZER" FontFamily="Bahnschrift SemiCondensed, Segoe UI"
                               FontSize="23" FontWeight="SemiBold" />
                    <TextBlock Text="重い原因と、次に何をするかを見る" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LastUpdatedText}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button Content="今すぐ更新" Click="RefreshButton_Click" Padding="17,9" Background="#285D73"
                            Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="310" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource PanelStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="現在のメモリの余裕" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding AvailableMemoryText}" FontFamily="Bahnschrift SemiCondensed, Segoe UI" FontSize="40" FontWeight="SemiBold" Margin="0,3,0,-3" />
                        <TextBlock Text="空きRAM" Foreground="{StaticResource Muted}" FontSize="13" />
                        <ProgressBar Style="{StaticResource TrackStyle}" Value="{Binding PhysicalUsedPercent, Mode=OneWay}" Margin="0,11,0,7" />
                        <TextBlock Text="{Binding MemoryDetailText}" Foreground="{StaticResource Muted}" FontSize="12" />
                        <Border Background="{StaticResource Line}" Height="1" Margin="0,11,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="メモリ確保量（コミット）" Foreground="{StaticResource Muted}" FontSize="11" />
                            <TextBlock Grid.Column="1" Text="{Binding CommitPercentText}" FontSize="14" FontWeight="SemiBold" />
                        </Grid>
                        <ProgressBar Style="{StaticResource TrackStyle}" Foreground="{StaticResource Copper}" Value="{Binding CommitUsedPercent, Mode=OneWay}" Margin="0,5,0,5" />
                        <TextBlock Text="{Binding PressureLabel}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CommitHeadroomText}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelStyle}" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="メモリ使用量の全体像" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="重複を除いたメモリ使用量の目安" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,2,0,8" />
                        <Border CornerRadius="4" ClipToBounds="True" Height="16" Background="#D5DDE0">
                            <StackPanel Orientation="Horizontal" Width="276">
                                <Border Width="{Binding ApplicationSegmentWidth}" Background="#B85F35" />
                                <Border Width="{Binding WindowsSegmentWidth}" Background="#285D73" />
                                <Border Width="{Binding KernelSegmentWidth}" Background="#6C596E" />
                                <Border Width="{Binding OtherSegmentWidth}" Background="#8A979C" />
                                <Border Width="{Binding AvailableSegmentWidth}" Background="#75A996" />
                            </StackPanel>
                        </Border>
                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="7" Height="7" Background="#B85F35" CornerRadius="2" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding ApplicationSegmentText}" FontSize="10" />
                        </Grid>
                        <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="7" Height="7" Background="#285D73" CornerRadius="2" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding WindowsSegmentText}" FontSize="10" /></Grid>
                        <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="7" Height="7" Background="#6C596E" CornerRadius="2" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding KernelSegmentText}" FontSize="10" /></Grid>
                        <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="7" Height="7" Background="#8A979C" CornerRadius="2" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding OtherSegmentText}" FontSize="10" /></Grid>
                        <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="7" Height="7" Background="#75A996" CornerRadius="2" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding AvailableSegmentText}" FontSize="10" /></Grid>
                        <TextBlock Text="共有分はアプリごとに重複して数えず、「共有・キャッシュ等」にまとめています。" Foreground="{StaticResource Muted}" FontSize="9" TextWrapping="Wrap" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelStyle}" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="メモリ使用量の内訳" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="SemiBold" />
                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="表示中16件" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="{Binding DisplayedTotalText}" FontFamily="Bahnschrift" FontWeight="SemiBold" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="全プロセス計" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="{Binding AllProcessesText}" FontFamily="Bahnschrift" FontWeight="SemiBold" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Windows関連プロセス" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="{Binding WindowsProcessesText}" FontFamily="Bahnschrift" FontWeight="SemiBold" />
                        </Grid>
                        <Border Background="{StaticResource Line}" Height="1" Margin="0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="カーネル・ドライバー" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="{Binding KernelMemoryText}" FontFamily="Bahnschrift" FontWeight="SemiBold" />
                        </Grid>
                        <TextBlock Text="{Binding KernelDetailText}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,2,0,0" />
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="システムキャッシュ" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="{Binding SystemCacheText}" FontFamily="Bahnschrift" FontWeight="SemiBold" />
                        </Grid>
                        <TextBlock Text="合計が一致しないのは正常です。共有分は重複し、キャッシュには空きメモリも含まれます。キャッシュの一部は再利用可能で、カーネルは直接終了できません。"
                                   Foreground="{StaticResource Muted}" FontSize="10" LineHeight="14" TextWrapping="Wrap" Margin="0,9,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelStyle}" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="過去7日のピーク" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding HistoryStatusText}" Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,8" />
                        <ItemsControl ItemsSource="{Binding HistoryHighlights}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5,0,5">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding AverageText}" Foreground="{StaticResource Muted}" FontSize="9" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding PeakText}" FontFamily="Bahnschrift" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding PeakAtText}" Foreground="{StaticResource Muted}" FontSize="9" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Grid.Row="0" CornerRadius="10" Padding="18">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#244A5A" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CapacityKey}" Value="ConsiderUpgrade"><Setter Property="Background" Value="#9A4D30" /></DataTrigger>
                                <DataTrigger Binding="{Binding CapacityKey}" Value="AppActionFirst"><Setter Property="Background" Value="#806126" /></DataTrigger>
                                <DataTrigger Binding="{Binding CapacityKey}" Value="CriticalAction"><Setter Property="Background" Value="#8B2F2F" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CAPACITY CHECK" Foreground="#A9C5CF" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CapacityTitle}" Foreground="White" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0" />
                            <TextBlock Text="{Binding CapacityDescription}" Foreground="#E3EDF0" FontSize="12" LineHeight="17" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="判断の根拠" Foreground="#A9C5CF" FontSize="10" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CapacityHistoryEvidence}" Foreground="#E3EDF0" FontSize="11" LineHeight="16" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <Border Background="#3B6070" Height="1" Margin="0,8,0,7" />
                            <TextBlock Text="{Binding ObservationText}" Foreground="White" FontSize="12" FontWeight="SemiBold" LineHeight="17" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Margin="3,16,3,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="起動中のプロセス・アプリ" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="効果と注意点を確認してから対策を選べます" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource Sage}" Margin="0,0,7,0" />
                        <TextBlock Text="3秒ごとに監視" Foreground="{StaticResource Muted}" FontSize="12" />
                    </StackPanel>
                </Grid>
                <ListBox Grid.Row="2" ItemsSource="{Binding Applications}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,10" Padding="17">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="250" /><ColumnDefinition Width="1" />
                                            <ColumnDefinition Width="18" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" Background="#E1EAED" CornerRadius="6" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Initial}" Foreground="{StaticResource Blue}" FontFamily="Bahnschrift" FontSize="17"
                                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,14,0">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ProcessSummary}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,12" />
                                                <TextBlock Text="現在使用中のRAM" Foreground="{StaticResource Muted}" FontSize="9" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding WorkingSetText}" FontFamily="Bahnschrift SemiCondensed" FontSize="23" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1" Text="{Binding TrendText}" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
                                                </Grid>
                                                <ProgressBar Style="{StaticResource TrackStyle}" Value="{Binding MemorySharePercent, Mode=OneWay}" Margin="0,5,0,6" />
                                                <TextBlock Text="{Binding PrivateText}" Foreground="{StaticResource Muted}" FontSize="11" />
                                            </StackPanel>
                                        </Grid>
                                        <Border Grid.Column="1" Background="{StaticResource Line}" />
                                        <Grid Grid.Column="3">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Reason}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,1,12,0" />
                                                <Border x:Name="SafetyPill" Grid.Column="1" Background="#E3EEE9" CornerRadius="10" Padding="9,3">
                                                    <TextBlock x:Name="SafetyText" Text="{Binding SafetyLabel}" Foreground="{StaticResource Sage}" FontSize="10" FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>
                                            <StackPanel Grid.Row="1" Margin="0,12,0,10">
                                                <TextBlock Text="推奨する対策" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Action}" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="効果の目安" Foreground="{StaticResource Muted}" FontSize="10" />
                                                    <TextBlock Text="{Binding Effect}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="注意点" Foreground="{StaticResource Muted}" FontSize="10" />
                                                    <TextBlock Text="{Binding SideEffect}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding SafetyKey}" Value="CheckFirst">
                                        <Setter TargetName="SafetyPill" Property="Background" Value="#F3E8D7" />
                                        <Setter TargetName="SafetyText" Property="Foreground" Value="{StaticResource Amber}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SafetyKey}" Value="Advanced">
                                        <Setter TargetName="SafetyPill" Property="Background" Value="#F3E1D9" />
                                        <Setter TargetName="SafetyText" Property="Foreground" Value="{StaticResource Copper}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SafetyKey}" Value="DoNotOperate">
                                        <Setter TargetName="SafetyPill" Property="Background" Value="#E6E9EA" />
                                        <Setter TargetName="SafetyText" Property="Foreground" Value="#59666C" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Grid>
</Window>
